{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FFmpeg": {
    "BinaryFolder": ""
  },
  "Services": {
    "TtsService": {
      "BaseUrl": "http://localhost:8000"
    },
    "ScriptService": {
      "BaseUrl": "http://localhost:8001"
    }
  },
  "Assets": {
    "BackgroundMusicFolder": "assets"
  },
  "OrchestrationSettings": {
    "MaxRetryAttempts": 2,
    "ToleranceSeconds": 0.2,
    "MaxSpeedFactor": 1.15,
    "MaxTtsParallelism": 2
  }
}
